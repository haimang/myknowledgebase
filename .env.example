# smind-family 本地配置示例 (复制为 .env; .env 已 git-ignored — 密钥不进仓 Q-RW-7/TR-5)
# 全部前缀 SMIND_; 留空即用 Settings 默认 (mock/local/bruteforce, 离线不打外网)。

# --- provider 路由 (RW-A) ---
# SMIND_LLM_PROVIDER=mock          # mock(默认) | mlx/openai/... (延后至 provider charter)
# SMIND_EMBEDDER_PROVIDER=local-hash  # local-hash(默认, 1024 维) | mlx(延后)
# SMIND_VECTOR_INDEX=bruteforce    # bruteforce(默认) | vec0(RW-D)

# --- 语义链模式 (RW-B) ---
# SMIND_SEMANTIC_MODE=rule         # rule(默认, 规则化) | llm(prompt→render→provider)
# SMIND_PROMPTS_DIR=prompts
# SMIND_MOCK_LLM_RESPONSES_PATH=   # real-wiring 路由 mock 侧的预置响应 JSON 文件

# --- 真实模型/密钥 (Q-RW-2/7: 本轮预留, provider charter 实装) ---
# SMIND_LLM_MODEL=
# SMIND_EMBEDDER_MODEL=
# SMIND_LLM_API_KEY=               # 真实厂商 key 时填; 切勿提交真实 .env
