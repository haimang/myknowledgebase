# Comma-separated internal bearer tokens. Never commit a real secret.
MKB_INTERNAL_TOKENS=dev-token-change-me
MKB_DATA_DIR=data
MKB_DATABASE_PATH=data/database/mkb_primary.db
MKB_OBJECT_ROOT=data/objects
# Origin only — the adapter appends /v1/embeddings. Do not include /v1.
MKB_INFERENCE_VLLM_BASE_URL=http://127.0.0.1:670
# Deploy-injected inference bearer. Never commit a real value.
MKB_INFERENCE_VLLM_TOKEN=
MKB_INFERENCE_PROBE_ENABLED=false
# Keep Qwen embedding local-vLLM enabled; generation has its own switch.
MKB_LIVE_INFERENCE=true
MKB_GENERATION_LOCAL_ENABLED=false
MKB_MODEL_CAPACITY_PRIORITY_GATE_ENABLED=true
MKB_NS1_CLI_MODE=subprocess
MKB_NS1_CLI_EXECUTABLE=claude
MKB_NS1_PROVIDER_PLAN=claude,agy,cursor-agent,grok
MKB_NS1_PRIMARY_MODEL=minimax-m3
MKB_NS1_AGY_EXECUTABLE=agy
MKB_NS1_CURSOR_AGENT_EXECUTABLE=cursor-agent
MKB_NS1_GROK_EXECUTABLE=grok
MKB_NS1_CLI_MAX_CONCURRENCY=8
MKB_NS1_CLAUDE_CONCURRENCY=3
MKB_NS1_AGY_CONCURRENCY=2
MKB_NS1_FALLBACK_CONCURRENCY=3
